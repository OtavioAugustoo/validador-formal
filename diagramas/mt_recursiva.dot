digraph MT_wHashw {
    label="MT -- Reconhecedor de L = {w#w | w em {0,1}*}\nnotacao das transicoes: lido / escrito , direcao";
    labelloc=top;
    labeljust=center;
    fontname="Helvetica";
    fontsize=12;
    rankdir=LR;
    nodesep=0.7;
    ranksep=0.9;

    node [shape=circle, fontname="Helvetica", fontsize=10, fixedsize=true, width=0.75];
    edge [fontname="Helvetica", fontsize=8];

    // seta inicial
    ini [style=invis, shape=point, width=0, height=0];

    // estados finais
    qaceita  [shape=doublecircle, style=filled, fillcolor="#ccffcc", label="qaceita"];
    qrejeita [shape=circle,       style=filled, fillcolor="#ffcccc", label="qrejeita"];

    ini -> q0;

    // q0: scan da esquerda, marca 0 ou 1 com X
    q0 -> q1      [label="0/X,R"];
    q0 -> q2      [label="1/X,R"];
    q0 -> q0      [label="X/X,R"];
    q0 -> q7      [label="#/#,R"];
    q0 -> qrejeita [label="_/_,R"];

    // q1: viu 0, atravessando ate o #
    q1 -> q1      [label="0,1,X\n/mesmo,R"];
    q1 -> q3      [label="#/#,R"];
    q1 -> qrejeita [label="_/_,R"];

    // q2: viu 1, atravessando ate o #
    q2 -> q2      [label="0,1,X\n/mesmo,R"];
    q2 -> q4      [label="#/#,R"];
    q2 -> qrejeita [label="_/_,R"];

    // q3: procura 0 correspondente na direita
    q3 -> q3      [label="Y/Y,R"];
    q3 -> q5      [label="0/Y,L"];
    q3 -> qrejeita [label="1,#,_\n/mesmo,R"];

    // q4: procura 1 correspondente na direita
    q4 -> q4      [label="Y/Y,R"];
    q4 -> q5      [label="1/Y,L"];
    q4 -> qrejeita [label="0,#,_\n/mesmo,R"];

    // q5: par encontrado, voltando pela direita
    q5 -> q5 [label="Y,0,1\n/mesmo,L"];
    q5 -> q6 [label="#/#,L"];

    // q6: voltando pela esquerda ate o primeiro X
    q6 -> q6 [label="0,1\n/mesmo,L"];
    q6 -> q0 [label="X/X,R"];

    // q7: verifica se a parte direita esta toda marcada com Y
    q7 -> q7      [label="Y/Y,R"];
    q7 -> qaceita  [label="_/_,R"];
    q7 -> qrejeita [label="0,1\n/mesmo,R"];
}
